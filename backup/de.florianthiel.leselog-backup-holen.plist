<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>de.florianthiel.leselog-backup-holen</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/florian/Projects/apps/leselog/backup/leselog-backup-holen.sh</string>
    </array>
    <!-- Nachts um 02:30 Uhr: Hintergrundarbeit läuft nicht tagsüber, wenn am Mac gearbeitet wird.
         Holt den Stand vom Server-Backup des Vortags (09:30) und läuft vor der
         Sonntags-Sicherung um 03:00, die ihn dann frisch nach Dropbox mitnimmt.
         Schläft der Mac um diese Zeit, holt launchd den Lauf beim Aufwachen nach. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>2</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>StandardOutPath</key>
    <string>/Users/florian/Leselog-Backups/holen.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/florian/Leselog-Backups/holen.log</string>
</dict>
</plist>
